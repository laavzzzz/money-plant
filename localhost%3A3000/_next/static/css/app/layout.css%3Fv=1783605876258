@layer base {
  :root, html, html.light, html.dark, [data-theme="dark"], [data-theme="light"] {
    --background: 0 0% 100% !important;
    --foreground: 222.2 84% 4.9% !important;
    --bg-main: #FFFFFF !important;
    --bg-arctic: #FCFEFF !important;
    --bg-pearl: #F7FAFC !important;
    --bg-glass-solid: #FDFDFD !important;
    --text-navy-deep: #071B44 !important;
    --text-navy-mid: #0E2D68 !important;
    --text-body-prose: #2A3E63 !important;
    --text-muted-meta: #62779F !important;
    --glass-bg: rgba(255, 255, 255, 0.75) !important;
    --glass-border: rgba(255, 255, 255, 0.85) !important;
    --glass-inner-border: rgba(53, 214, 255, 0.12) !important;
    --glass-blur: blur(30px) saturate(220%) !important;
    --shadow-premium-glow: 0px 20px 80px rgba(53, 214, 255, 0.15), 0px 4px 12px rgba(79, 140, 255, 0.03) !important;
    --shadow-float: 0px 32px 64px rgba(46, 230, 214, 0.12), 0px 8px 32px rgba(182, 180, 255, 0.05) !important;
    --shadow-btn-neon: 0px 8px 24px rgba(46, 230, 214, 0.35) !important;
    color-scheme: light !important;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }
  html, body {
    background-color: var(--bg-main) !important;
    background: var(--bg-main) !important;
    color: var(--text-body-prose) !important;
    min-height: 100dvh;
    width: 100%;
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(rgba(53, 214, 255, 0.02) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(53, 214, 255, 0.02) 1px, transparent 1px) !important;
    background-size: 56px 56px !important;
    pointer-events: none;
    z-index: 1;
  }
  body, section, div, main, header, footer {
    background-color: transparent;
  }
  h1, h2, h3, h4, h5, h6, strong, th, td {
    color: var(--text-navy-deep) !important;
    letter-spacing: -0.04em;
    font-weight: 800;
  }
  p, span, label, li, a {
    color: var(--text-body-prose) !important;
  }
  *:focus-visible {
    outline: 2px solid var(--color-cyan-glow);
    outline-offset: 2px;
  }
}
